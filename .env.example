OPENAI_API_KEY=
OPENAI_MODEL_EXTRACT=
OPENAI_MODEL_REASON=
OPENAI_MODEL_TRANSCRIBE=
OPENAI_MODEL_IMAGE=
OPENAI_MODEL_EMBED=
OPENAI_ROUTER_EFFORT=none
OPENAI_COMPOSER_EFFORT=low
OPENAI_SCHEMA_WARMUP=true
CORS_ORIGINS=[]
BUILD_SHA=

# Default off. Enable only on the owner-managed judging service.
ALLOW_PENDING_REVIEW=false
# Render Secret File path; no URL or token is used.
PRIVATE_CORPUS_PATH=
CORPUS_MANIFEST_PATH=corpus/manifest.json

# Empty disables direct runtime MCP reads; only the approved exact URL is accepted.
ISLAMIC_CONTENT_MCP_URL=https://mcp.islamiccontent.org/mcp
